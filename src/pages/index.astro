---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="sJWehs45v5m_LIfG05lbmNbSW6cjlpNA9SZm3C3A6fM" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <title>Bus vertrektijden via Home Assistant | busvertrektijden</title>
    <meta
      name="description"
      content="Integratie voor bus vertrektijden in Nederland via Home Assistant. Volg eenvoudig de vertrektijden van je favoriete haltes."
    />
  </head>
  <!-- MD breakpoint -->
  <body class="bg-slate-100">
    <div class="mt-14 md:mt-24 text-center w-11/12 mx-auto max-w-4xl">
      <span class="uppercase">busvertrektijden.nl</span>
      <h1 class="mt-6 md:mt-8 text-xl md:text-3xl">Live vertrektijden van de bussen in Nederland</h1>
      <p class="mt-1">Volg eenvoudig via Home Assistant de vertrektijden van je favoriete haltes.</p>
      <div id="links" class="mt-8">
        <a
          href="https://github.com/kerstenremco/busvertrektijden-ha/wiki/Installatie-HomeAssistant"
          target="_blank"
          class="mr-1 w-1/2 bg-blue-950 border-blue-950 border-2 py-2 px-4 rounded text-blue-50">HomeAssistant</a
        >
        <a href="/web" target="_blank" class="border-blue-950 border-2 py-2 px-4 rounded text-blue-950">Webversie</a>
      </div>
      <img src="/hero.png" alt="Home Assistant Integratiescherm" class="w-full mt-12 md:mt-20 mx-auto" />
    </div>
  </body>
</html>
