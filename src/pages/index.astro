---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Bus vertrektijden</title>
  </head>
  <body>
    <div class="text-center p-8">
      <h1 class="text-4xl text-burning-orange-800 mt-28">Bus vertrektijden</h1>
      <p class="mt-3 text-lg text-burning-orange-900">HomeAssistant integratie voor bus vertrektijden in Nederland</p>
      <div class="my-12">
        <a
          href="https://github.com/kerstenremco/busvertrektijden-ha/wiki/Installatie-HomeAssistant"
          target="_blank"
          class="inline-block bg-burning-orange-400 px-8 py-2 rounded mr-4 text-burning-orange-50">Ga naar documentatie</a
        >
        <a href="/busvertrektijden-www/web" target="_blank" class="inline-block text-burning-orange-900 font-bold">Probeer online</a>
      </div>
      <div class="py-16 px-12 bg-burning-orange-400 w-3/4 mx-auto rounded-2xl">
        <img src="/busvertrektijden-www/public/hero.png" alt="Home Assistant Integratiescherm" class="mx-auto rounded-xl shadow-lg" />
      </div>
    </div>
  </body>
</html>
